---
import Layout from "@layouts/Layout.astro";
---

<Layout
  title="Page Not Found | Box Rental Now"
  description="The page you're looking for doesn't exist. Head back home or get a free moving and storage quote."
  ogImage=""
>
  <section class="section">
    <div class="custom-container text-center">
      <span class="eyebrow">404 Error</span>
      <h1 class="display mt-5">Page Not Found</h1>
      <div class="accent-bar mx-auto"></div>
      <p class="lead mt-6 mx-auto max-w-xl text-secondary">
        Sorry, we couldn't find the page you were looking for. It may have
        been moved or no longer exists.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary btn-lg">Back to Home</a>
        <a href="/contact-us" class="btn-outline btn-lg">Contact Us</a>
      </div>
    </div>
  </section>
</Layout>
