---
interface ButtonProps {
  label?: string;
  title?: string;
  link?: string;
  variant?: "primary" | "secondary" | "outline" | "white";
}
const { label, title, link, variant = "primary" } = Astro.props as ButtonProps;
const cls = `btn-${variant}`;
const text = title ?? label;
---

{
  link ? (
    <a href={link} class={cls}>
      <slot>{text}</slot>
    </a>
  ) : (
    <button class={cls}>
      <slot>{text}</slot>
    </button>
  )
}
